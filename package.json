{
  "name": "openchamber-prompt",
  "version": "0.1.5",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "OpenChamber 内置提示词覆盖：一键应用、备份与还原。",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.4.0"
    },
    "contributes": {
      "panel": {
        "id": "prompt-override",
        "name": "内置提示词",
        "icon": "brain",
        "entry": "panel/index.html"
      },
      "statusSection": {
        "entry": "panel/section.html",
        "title": "内置提示词",
        "height": 56
      },
      "filesystem": [
        "~/.config/opencode/agents/build.md",
        "~/.config/openchamber/prompt-override/**"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "node scripts/preview.mjs",
    "share": "node scripts/share.mjs"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.0.3",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
